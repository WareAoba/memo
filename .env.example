# Backend: run from repository root. Process environment overrides .env.
BIND_ADDRESS=127.0.0.1:3000
DATABASE_PATH=data/database/app.sqlite3
RUST_LOG=info

# Optional exact browser origins (comma-separated). Unset uses loopback ports 3000/15173/8080.
# APP_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://127.0.0.1:3000

# Local Vite proxy target; never exposed as a browser API URL.
API_PROXY_TARGET=http://127.0.0.1:3000

# Docker Compose: local-only HTTP development entry.
APP_PORT=8080
# Named Docker volume by default. For production, use an encrypted host path.
DATA_VOLUME=app-data

PHOTO_DIR=data/photos

# Web Push: key is generated once and must be persisted/backed up.
PUSH_ENABLED=true
VAPID_KEY_PATH=data/push/vapid.key
# Replace with the operator contact before deployment.
VAPID_SUBJECT=mailto:admin@example.invalid
