    "build.mjs": "import { build } from '../../frontend/node_modules/vite/dist/node/index.js';\nimport fs from 'node:fs';\nimport { gzipSync } from 'node:zlib';\nconst root = 'C:/Git/memo';\nconst base = root + '/test-results/performance-audit';\nconst modules = [];\nawait build({configFile:false,root:root+'/frontend',build:{outDir:base+'/app-build',emptyOutDir:true},plugins:[{name:'sizes',generateBundle(_,bundle){for(const chunk of Object.values(bundle)) if(chunk.type==='chunk') for(const [id,m] of Object.entries(chunk.modules)) modules.push({id:id.replace(root+'/',''),bytes:m.renderedLength});}}]});\nfs.writeFileSync(base+'/bundle.json',JSON.stringify({modules:modules.sort((a,b)=>b.bytes-a.bytes),assets:fs.readdirSync(base+'/app-build/assets').map(file=>{const b=fs.readFileSync(base+'/app-build/assets/'+file);return {file,bytes:b.length,gzip:gzipSync(b).length};})},null,2));\nawait build({configFile:false,root:base,resolve:{alias:[{find:'react-dom/client',replacement:root+'/frontend/node_modules/react-dom/profiling.js'},{find:'react',replacement:root+'/frontend/node_modules/react'},{find:'react-dom',replacement:root+'/frontend/node_modules/react-dom'}]},build:{outDir:base+'/dist',emptyOutDir:true},plugins:[{name:'instrument',enforce:'pre',transform(code,id){if(id.endsWith('/scheduleAppearance.ts')) return code.replace(\"import { tr }\", \"import { tr }\").replace('now.toLocaleTimeString(', 'window.auditTime(now, ').replace('const date = dateInZone(item.time_zone, now);','const date = window.auditDate(item.time_zone, now, dateInZone);');}}]});\n",
    "main.tsx": "import React, { Profiler } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { Today } from '../../frontend/src/features/workspace/Today';\nimport { Calendar } from '../../frontend/src/features/workspace/Calendar';\nimport { scheduleAppearance } from '../../frontend/src/features/workspace/scheduleAppearance';\nimport { calendarWeeks } from '../../frontend/src/features/workspace/calendarLayout';\nimport { getRangeScheduleSummaries } from '../../frontend/src/api/schedules';\nimport { emptyFields } from '../../frontend/src/api/works';\nimport i18n from '../../frontend/src/i18n';\nimport '../../frontend/src/styles.css';\nimport '../../frontend/src/design-system.css';\nconst realFetch=window.fetch.bind(window), sleep=(ms)=>new Promise(r=>setTimeout(r,ms));\nconst root=createRoot(document.getElementById('root')!);\nconst results:any={userAgent:navigator.userAgent,viewport:[innerWidth,innerHeight],renders:[],appearance:[],calendar:[],requests:[]};\nlet items:any[]=[],calls=0,latency=0,commits:any[]=[],cached=false;\nconst df=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Tokyo',year:'numeric',month:'2-digit',day:'2-digit'});\nconst tf=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Tokyo',hourCycle:'h23',hour:'2-digit',minute:'2-digit'});\nwindow.auditTime=(now,locale,opts)=>cached?tf.format(now):now.toLocaleTimeString(locale,opts);\nwindow.auditDate=(zone,now,original)=>{if(!cached)return original(zone,now);const parts=df.formatToParts(now), part=t=>parts.find(p=>p.type===t)!.value;return `${part('year')}-${part('month')}-${part('day')}`;};\nwindow.fetch=async (url,options)=>{const u=new URL(String(url),location.href);if(!u.pathname.startsWith('/api/'))return realFetch(url,options);calls++;if(latency)await sleep(latency);if(u.pathname==='/api/schedules'){const offset=Number(u.searchParams.get('offset')||0),limit=Number(u.searchParams.get('limit')||20);return new Response(JSON.stringify({items:items.slice(offset,offset+limit),total:items.length,offset,limit,revision:1}),{headers:{'Content-Type':'application/json'}});}return new Response(JSON.stringify({items:[],total:0,limit:20,offset:0}),{headers:{'Content-Type':'application/json'}});};\nconst make=(n,tasks=3)=>Array.from({length:n},(_,i)=>({id:'s'+i,entity_id:'e',entity_name:'Work '+i,title:'Work '+i,scheduled_date:'2026-09-27',end_date:'2026-09-27',start_time:'09:00',end_time:'10:00',time_zone:'Asia/Tokyo',status:'planned',notes:'',created_at:'',updated_at:'',entity_snapshot:{...emptyFields,name:'Work '+i},tasks:Array.from({length:tasks},(_,j)=>({id:`t${i}-${j}`,status:'pending',execution_notes:'',name_snapshot:'Task '+j,default_notes_snapshot:'',source_task_preset_version:1,items:[]}))}));\nconst stats=(a)=>{const s=[...a].sort((a,b)=>a-b);return {n:s.length,median:s[Math.floor(s.length/2)]??0,p95:s[Math.min(s.length-1,Math.ceil(s.length*.95)-1)]??0,max:s.at(-1)??0};};\nconst onRender=(id,phase,duration,base,start,commit)=>commits.push({phase,duration,at:performance.now()});\nasync function run(){await i18n.changeLanguage('ko');\nfor(const count of [100,50,10]) for(const cache of [true,false]){cached=cache;items=make(count);calls=0;commits=[];const start=performance.now();root.render(<Profiler id=\"Today\" onRender={onRender}><Today key={`${count}-${cache}`} today=\"2026-09-27\" timeZone=\"Asia/Tokyo\"/></Profiler>);await sleep(7500);const steady=commits.filter(c=>c.at>start+800);results.renders.push({count,tasksPerSchedule:3,cachedFormatters:cache,requests:calls,nodes:document.getElementById('root')!.querySelectorAll('*').length,initial:commits.filter(c=>c.at<=start+800),steady:stats(steady.map(c=>c.duration))});document.getElementById('status')!.textContent=JSON.stringify(results,null,2);root.render(null);await sleep(100);}\nfor(const count of [10,50,100]){items=make(count);for(const cache of [false,true]){cached=cache;const times=[];for(let r=0;r<15;r++){const t=performance.now();for(const item of items)scheduleAppearance(item,new Date('2026-09-27T04:00:00Z'));times.push(performance.now()-t);}results.appearance.push({count,cachedFormatters:cache,...stats(times.slice(3))});}}\nfor(const count of [100,1000,5000]){items=make(count,0).map((x,i)=>({...x,scheduled_date:`2026-${String(1+i%12).padStart(2,'0')}-15`,end_date:`2026-${String(1+i%12).padStart(2,'0')}-15`}));const times=[];for(let r=0;r<8;r++){const start=performance.now();for(let m=1;m<=12;m++)calendarWeeks(`2026-${String(m).padStart(2,'0')}`,items);times.push(performance.now()-start);}commits=[];root.render(<Profiler id=\"Calendar\" onRender={onRender}><Calendar key={count} today=\"2026-09-27\" mode=\"year\"/></Profiler>);await sleep(900);results.calendar.push({count,layout:stats(times.slice(2)),commits,nodes:document.getElementById('root')!.querySelectorAll('*').length});root.render(null);await sleep(100);}\nfor(const count of [100,1000]){items=make(count,0);for(const delay of [0,40]){latency=delay;calls=0;const start=performance.now();await getRangeScheduleSummaries('2026-01-01','2026-12-31');const first=performance.now()-start;const again=performance.now();await getRangeScheduleSummaries('2026-01-01','2026-12-31');results.requests.push({count,simulatedLatencyMs:delay,firstMs:first,revisitMs:performance.now()-again,totalCalls:calls});}}latency=0;\ndocument.getElementById('status')!.textContent='COMPLETE\\n'+JSON.stringify(results,null,2);await realFetch('/results',{method:'POST',body:JSON.stringify(results,null,2)});}\nrun().catch(async e=>{document.getElementById('status')!.textContent=e.stack;await realFetch('/results',{method:'POST',body:JSON.stringify({error:e.stack,partial:results})});});\n",
    "server.mjs": "import http from 'node:http';import fs from 'node:fs';import path from 'node:path';\nconst base='C:/Git/memo/test-results/performance-audit';\nhttp.createServer(async(req,res)=>{if(req.url==='/results'&&req.method==='POST'){let body='';for await(const chunk of req)body+=chunk;fs.writeFileSync(base+'/browser-results.json',body);res.end('ok');return;}const url=new URL(req.url,'http://localhost');const file=path.join(base,'dist',url.pathname==='/'?'index.html':url.pathname);if(!file.startsWith(path.join(base,'dist'))||!fs.existsSync(file)){res.statusCode=404;res.end();return;}res.setHeader('Content-Type',file.endsWith('.js')?'text/javascript':file.endsWith('.css')?'text/css':'text/html');res.end(fs.readFileSync(file));}).listen(15180,'127.0.0.1',()=>console.log('Audit http://127.0.0.1:15180'));\n",
    "api.mjs": "import fs from 'node:fs';\nconst base='http://127.0.0.1:3010';\nasync function request(url,body){const r=await fetch(base+url,{method:body?'POST':'GET',headers:{'Content-Type':'application/json'},...(body?{body:JSON.stringify(body)}:{})});const text=await r.text();if(!r.ok)throw new Error(r.status+' '+text);return {json:JSON.parse(text),bytes:Buffer.byteLength(text)};}\nlet {json:page}=await request('/api/schedules');\nfor(let i=page.total;i<1000;i++){const day=i<100?'2026-09-27':`2026-${String(i%12+1).padStart(2,'0')}-15`;await request('/api/schedules',{entity_name:'Audit Work',title:'Audit '+i,scheduled_date:day,end_date:day,start_time:'09:00',end_time:'10:00',time_zone:'Asia/Tokyo',task_preset_ids:[{name:'Audit Task A'},{name:'Audit Task B'},{name:'Audit Task C'}]});if(i%200===0)console.log('seeded',i+1);}\nconst stats=a=>{a.sort((x,y)=>x-y);return {median:a[Math.floor(a.length/2)],p95:a[Math.ceil(a.length*.95)-1],samples:a.length};};\nconst output=[];\nfor(const kind of ['day-details','year-summary','search'])for(const limit of [20,100]){const times=[],single=[],bytes=[];let pages=0,total=0;for(let run=0;run<8;run++){const start=performance.now();let offset=0,revision,transferred=0;pages=0;do{const q=new URLSearchParams({limit:String(limit),offset:String(offset),...(kind==='day-details'?{date:'2026-09-27',include_details:'true'}:kind==='year-summary'?{from:'2026-01-01',to:'2026-12-31'}:{q:'Audit'}),...(revision===undefined?{}:{revision:String(revision)})});const t=performance.now();const r=await request('/api/schedules?'+q);single.push(performance.now()-t);transferred+=r.bytes;total=r.json.total;revision=r.json.revision;offset+=r.json.items.length;pages++;if(kind==='search')break;}while(offset<total);if(run>0){times.push(performance.now()-start);bytes.push(transferred);}}output.push({kind,limit,total,pages,fullRangeMs:stats(times),pageMs:stats(single),bytes:bytes[0]});}\nfs.writeFileSync('C:/Git/memo/test-results/performance-audit/api-results.json',JSON.stringify(output,null,2));console.log(JSON.stringify(output,null,2));\n",
